<Window x:Class="F1TelemetryOverlay.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F1 25 Telemetry Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="460"
        Height="150">
    <Grid Background="Transparent">
        <local:OverlaySurface x:Name="Surface" xmlns:local="clr-namespace:F1TelemetryOverlay.Wpf" />
    </Grid>
</Window>
